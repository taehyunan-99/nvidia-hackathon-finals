server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /healthz {
        access_log off;
        return 200 'ok';
    }
    location = /api/maps-config {
        if ($http_x_duru_origin != "${DURU_ORIGIN_TOKEN}") { return 403; }
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"clientId":"${NAVER_MAP_CLIENT_ID}"}';
    }
    location /api/ {
        if ($http_x_duru_origin != "${DURU_ORIGIN_TOKEN}") { return 403; }
        proxy_pass http://host.docker.internal:28081;
        proxy_read_timeout 60s;
        proxy_set_header X-Run-Owner $http_x_run_owner;
        add_header Cache-Control "no-store";
    }
    location / {
        if ($http_x_duru_origin != "${DURU_ORIGIN_TOKEN}") { return 403; }
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
    location /assets/ {
        if ($http_x_duru_origin != "${DURU_ORIGIN_TOKEN}") { return 403; }
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
