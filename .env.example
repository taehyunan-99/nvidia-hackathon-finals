# 실제 SDK/도구에 맞춰 변수명을 연결한다. 값은 저장/공유하지 않는다.
NVIDIA_API_KEY=
NGC_API_KEY=
MODEL_ID=
MODEL_BASE_URL=
RUN_MODE=mock
# 서울열린데이터광장 일반 인증키 (공공서비스예약 API)
SEOUL_OPEN_DATA_API_KEY=
MAX_STEPS=10
MAX_RUNTIME_SECONDS=900
# 본선 공통 기본값: docs/playbooks/model-policy.json. SDK가 자동 적용하지 않음.
NEMOTRON_REQUEST_LIMIT=40
NEMOTRON_DAILY_REQUEST_LIMIT=4000
MODEL_REQUEST_INTERVAL_SECONDS=15
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_MAX_ATTEMPTS=3
MODEL_MAX_RETRY_WAIT_SECONDS=120
# 비워 두면 runs/model-daily-budget.sqlite3 사용; 팀/프로세스별 별도 장부는 합산되지 않음.
MODEL_DAILY_BUDGET_PATH=
